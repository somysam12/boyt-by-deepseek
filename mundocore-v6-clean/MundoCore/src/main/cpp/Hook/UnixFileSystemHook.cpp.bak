/*
 * getSpace0(File, I)J
 */
HOOK_JNI(jlong, getSpace0, JNIEnv *env, jobject obj, jobject file, jint type) {
    jobject redirect = IO::redirectPath(env, file);
    jlong res = orig_getSpace0(env, obj, redirect, type);
    env->DeleteLocalRef(redirect);
    return res;
}

void UnixFileSystemHook::init(JNIEnv *env) {
    const char *cls = "java/io/UnixFileSystem";
   // JniHook::HookJniFun(env, cls, "canonicalize0","(Ljava/lang/String;)Ljava/lang/String;",(void *) new_canonicalize0,(void **) &orig_canonicalize0, false);
    JniHook::HookJniFun(env, cls, "getLastModifiedTime0","(Ljava/io/File;)J",(void *) new_getLastModifiedTime0,(void **) &orig_getLastModifiedTime0, false);
    JniHook::HookJniFun(env, cls, "setPermission0","(Ljava/io/File;IZZ)Z",(void *) new_setPermission0,(void **) &orig_setPermission0, false);
    JniHook::HookJniFun(env, cls, "createFileExclusively0","(Ljava/lang/String;)Z",(void *) new_createFileExclusively0,(void **) &orig_createFileExclusively0, false);
    JniHook::HookJniFun(env, cls, "list0","(Ljava/io/File;)[Ljava/lang/String;",(void *) new_list0,(void **) &orig_list0, false);
    JniHook::HookJniFun(env, cls, "createDirectory0","(Ljava/io/File;)Z",(void *) new_createDirectory0,(void **) &orig_createDirectory0, false);
    JniHook::HookJniFun(env, cls, "setLastModifiedTime0","(Ljava/io/File;J)Z",(void *) new_setLastModifiedTime0,(void **) &orig_setLastModifiedTime0, false);
    JniHook::HookJniFun(env, cls, "setReadOnly0","(Ljava/io/File;)Z",(void *) new_setReadOnly0,(void **) &orig_setReadOnly0, false);
    JniHook::HookJniFun(env, cls, "getSpace0","(Ljava/io/File;I)J",(void *) new_getSpace0,(void **) &orig_getSpace0, false);
}